    <AllowGlobals>True</AllowGlobals>
    <DefaultGlobalsToPublic>True</DefaultGlobalsToPublic>
    <ExportAllTypes>True</ExportAllTypes>
    <CreateFXFile>True</CreateFXFile>
    <OutputPath>..\Bin\Packages\$(DelphiSDK)</OutputPath>
  </PropertyGroup>
  <!-- Explicit targets follow the compiler profiles. SDK import separately gates runtime builds on native acceptance. -->
