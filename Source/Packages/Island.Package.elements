<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build" ToolsVersion="4.0">
  <PropertyGroup>
    <ProjectGuid>{0CBEE1E3-D8D5-4382-A154-959AB0C3B775}</ProjectGuid>
    <OutputType>Library</OutputType>
    <BinaryName>Delphi.Island</BinaryName>
    <RootNamespace>RemObjects.Elements.System</RootNamespace>
    <DelphiPackageName>Delphi.Island.bpl</DelphiPackageName>
    <DelphiPackageRuntime>True</DelphiPackageRuntime>
    <NoIsland>False</NoIsland>
    <NoDelphi>True</NoDelphi>
    <AllowGlobals>True</AllowGlobals>
    <DefaultGlobalsToPublic>True</DefaultGlobalsToPublic>
    <ExportAllTypes>True</ExportAllTypes>
    <CreateFXFile>True</CreateFXFile>
    <OutputPath>..\Bin\Packages\$(DelphiSDK)</OutputPath>
  </PropertyGroup>
  <!-- Add targets only after their package writer and native acceptance are supported. -->
  <PropertyGroup Condition="'$(Target)' == 'Delphi.13.Windows'">
    <Mode>Island</Mode>
    <SubMode>Windows</SubMode>
    <Architecture>x86_64</Architecture>
    <DelphiSDK>Delphi 13</DelphiSDK>
    <DelphiPackageVersion>13.2</DelphiPackageVersion>
    <DelphiRequiredPackages>rtl=rtl370.bpl</DelphiRequiredPackages>
    <ConditionalDefines>ISLAND_PACKAGE_RUNTIME;WINDOWS</ConditionalDefines>
    <LinkerOptions>/entry:__elements_package_entry</LinkerOptions>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Bridges.Delphi.pas" />
    <Compile Include="..\Strings\Strings.pas" />
    <Compile Include="..\Variant.pas" />
    <Compile Include="..\Attributes.pas" />
    <Compile Include="..\File.pas" />
    <Compile Include="..\Booleans.pas" />
    <Compile Include="..\DelphiHelpers.pas" />
    <Compile Include="..\Test.pas" />
    <Compile Include="..\Bridges.Cocoa.pas" />
    <Compile Include="..\MemoryHelpers.pas" />
    <Compile Include="..\Strings\StringHelpers.pas" />
    <Compile Include="..\Strings\UnicodeString.pas" />
    <Compile Include="..\Strings\AnsiString.pas" />
    <Compile Include="..\Strings\WideString.pas" />
    <Compile Include="..\Strings\ShortString.pas" />
    <Compile Include="..\DelphiObjectInfo.pas" />
    <Compile Include="..\Extensions.pas" />
    <Compile Include="..\DelphiIntrinsicRoutines.pas" />
    <Compile Include="..\Floats.pas" />
    <Compile Include="..\Arrays.pas" />
    <Compile Include="RuntimePackageModule.pas" />
    <Compile Include="IslandPackageRuntime.pas" />
    <Reference Include="Island" />
    <Reference Include="gc" />
    <Reference Include="IslandMath" />
    <Reference Include="rtl" />
    <Reference Include="winrt" />
    <Reference Include="Delphi.rtl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.targets" />
</Project>
